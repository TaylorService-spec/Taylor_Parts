rules_version = '2';

// =================================================================================================
// FIREBASE GIVES ACCESS TO THE SYSTEM. IT DOES NOT DECIDE WHAT ANYONE MAY DO.
// =================================================================================================
//
// Owner direction, 2026-09-07, stated repeatedly and finally without qualification: get rules
// management out of Firebase; keep the picker logic only. What a person may do comes from the Role
// permissions and object permissions administered in Admin -- the governed capability model -- and
// from nowhere else. This file is no longer a policy layer. It is a locked door.
//
// WHAT THIS FILE USED TO BE. 1,876 lines and 88 role-dependent clauses across 56 collections,
// deciding access with `isAdminOrDispatcher()`, `isAdmin()`, `isTechnician()` and a family of
// operational-role predicates -- all of them reading the LEGACY `users/{uid}.role` string or the
// employee document. Firestore was the rule keeper, and the rule it kept was the legacy role: the
// exact arrangement the governed access model was built to replace, still deciding every read while
// the governed model sat beside it deciding nothing.
//
// WHAT REMAINS, AND WHY EACH ONE IS ACCESS RATHER THAN AUTHORIZATION
//
//   1. isSignedIn(). Is this a valid session. That is authentication -- Firebase's actual job.
//
//   2. users/{uid}, OWN DOCUMENT ONLY. The governed capability feed subscribes to the caller's own
//      accessVersion to know when its answers went stale. Denying it would break the very model
//      this file is deferring to. A principal may read their own session record and no other.
//
//   3. The PARTS_MANAGER assignment-candidate read on employees -- "the picker logic", kept by
//      explicit Owner direction. It is the one operational-role predicate left, and it is a
//      least-privilege grant: ACTIVE, PARTS_ASSOCIATE-eligible, linked candidates only, never the
//      general directory.
//
// EVERYTHING ELSE IS DENIED, and the denial is the point. A collection with no match block is
// already denied by Firestore's default; the catch-all below states it rather than leaving it to be
// inferred. Access reaches the client through governed trusted callables that resolve a capability
// server-side (the pattern: workforce.directory.read -> listWorkforceDirectory).
//
// ════════════════════ THE CLIENT HAS CAUGHT UP ════════════════════
//
// This header used to warn that deploying would dark every surface still talking to Firestore
// directly, and listed ~10 collections across 76 client files for reads plus ELEVEN collections
// accepting client-direct writes. THAT IS NO LONGER THE STATE, and leaving the warning would be as
// misleading as the over-confident draft it replaced.
//
// MEASURED, repository-wide and by OPERATION rather than by import count:
//
//   DIRECT CLIENT GOVERNED BUSINESS READS    0
//   DIRECT CLIENT GOVERNED BUSINESS WRITES   0
//   FIRESTORE EOS AUTHORIZATION DECISIONS    0
//
// Every business read goes through a governed source (governedReadRegistry.ts + readGovernedList /
// countGovernedList) or the scoped work-order seam. Every business write goes through a trusted
// command that resolves a capability server-side. The shared client write transport
// (collectionStore / firebaseSafe) and the generic direct-read hooks (firestoreListSource,
// useFirestoreCollection) are DELETED, not disabled -- there is no dormant escape hatch left.
//
// The governed-field protections that lived HERE as Rules predicates moved into the commands that
// replace those writes and are tested there: accounts' admin-only paymentTerms/taxStatus, the
// reorder status transitions and their assignee record scope, and equipment's changed-key allowlist,
// cross-document location ownership and ACTIVE<->INACTIVE transition guard. None was dropped.
//
// The full file-by-file classification of what still touches Firestore lives in
// docs/governance/firebase-removal-closure-ledger.md.
//
// STILL NOT DEPLOYED. Rules are not auto-deployed in this repository (docs/Deployment.md §3) and a
// rules change is always Tier 2 (docs/DelegationCharter.md §2), so committing this changes nothing
// live. Deployment is its own authorized action -- verify with the verify-rules-deploy skill.
// =================================================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // AUTHENTICATION. The only question Firebase still answers.
    function isSignedIn() {
      return request.auth != null;
    }

    // The caller's own session record. Used ONLY by the two clauses below, and never to read a
    // role: `userData().role` is the legacy string this file no longer consults anywhere.
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function linkedEmployeeId() {
      return userData().employeeId;
    }

    // THE PICKER PREDICATE, kept by explicit Owner direction and used by exactly one clause.
    // Reciprocal-link + ACTIVE + operational-role membership, binding the employee document once
    // via `let` rather than paying for a second get() per call.
    function isActiveOperationalRole(role) {
      let employeeId = linkedEmployeeId();
      let employee = get(/databases/$(database)/documents/employees/$(employeeId)).data;
      return isSignedIn()
        && employeeId != null
        && employee.userId == request.auth.uid
        && employee.employmentStatus == "ACTIVE"
        && employee.operationalRoles is list
        && employee.operationalRoles.hasAny([role]);
    }

    // ── SESSION IDENTITY ──────────────────────────────────────────────────────────────────────
    // Own document only. A principal may not read another's, which is what made `userData().role`
    // usable as an authorization input in the first place.
    //
    // Writes stay denied, unchanged and unconditionally: role documents are provisioned by the
    // governed operator path (functions/scripts/provisionEmployeeAccess.js), never by a client.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ── THE PICKER ────────────────────────────────────────────────────────────────────────────
    // The ONE surviving operational-role grant (Owner: "you can keep the picker logic only"). It
    // serves useAssignableEmployees' candidate query and nothing else: a PARTS_MANAGER may read
    // ONLY Employee documents matching the assignment-candidate contract -- ACTIVE,
    // PARTS_ASSOCIATE-eligible, linked -- never the general directory.
    //
    // The three resource.data conditions mirror buildAssignableEmployeesQuery() exactly
    // (employmentStatus=="ACTIVE", operationalRoles array-contains "PARTS_ASSOCIATE", userId!=null),
    // so the picker's list query is provably within this grant and needs no new index. Any
    // non-candidate document stays denied.
    //
    // The general directory read that used to sit beside this -- `isAdminOrDispatcher()` -- is
    // GONE. It is served by the governed `listWorkforceDirectory` callable, authorized on
    // `workforce.directory.read` (Users/Read in the Objects grid).
    match /employees/{employeeId} {
      allow read: if isActiveOperationalRole("PARTS_MANAGER")
        && resource.data.employmentStatus == "ACTIVE"
        && resource.data.operationalRoles.hasAny(["PARTS_ASSOCIATE"])
        && resource.data.get("userId", null) != null;
      allow create, update, delete: if false;
    }

    // ── EVERYTHING ELSE ───────────────────────────────────────────────────────────────────────
    // No reads, no writes, no exceptions, no role logic. Access to any of this data is a governed
    // capability resolved server-side by a trusted callable, decided by the Role and object
    // permissions administered in Admin.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
