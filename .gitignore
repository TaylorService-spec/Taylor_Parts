.claude/scheduled_tasks.lock
# Local-only path to a service account key, never the key itself --
# still not something to commit (points at where a live GCP credential
# lives on this machine).
.claude/skills/*/keypath.local.txt
*.local.txt
*.local.json

build/
dist/
node_modules/
.vscode/
.firebase/

# Sandbox-only persona credentials — generated at activation, never committed.
*credentials.local.json

# EOS network telemetry (Phase 4) — raw machine-local logs must never be committed (see docs/orchestration/network-telemetry.md §13)
netwatch-standalone.csv
netwatch-full.csv
netwatch.pid
netwatch.log
**/netwatch-*.csv
.mcp.json

# Operator access-intent / result records written by
# functions/scripts/operatorAccessCommand.js. These are deliberately LOCAL
# operator-side evidence (mode 0600), never governed objects, and they carry
# principal UIDs -- they must never be committed.
functions/.operator-access-intents/
.operator-access-intents/

# Emulator debug output — generated at runtime, never a repo artifact.
firestore-debug.log
firebase-debug.log
.impeccable/
