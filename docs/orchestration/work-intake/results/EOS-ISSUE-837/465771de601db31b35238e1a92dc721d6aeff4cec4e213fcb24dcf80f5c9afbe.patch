index 0000000..cf3ede2
--- /dev/null
+++ b/docs/orchestration/lib/outcomeGate.mjs
@@ -0,0 +1,208 @@
+// EOS Outcome Gate — the correction for EOS-ISSUE-836 (#834/#835).
+//
+// THE DEFECT: `runIntakeExecution` (intakeExecute.mjs) persisted a durable status of COMPLETE the
+// moment the Wake Supervisor reported `SPAWNED_COMPLETED` — a clean process exit with parseable JSON
+// output. A zero exit code proves the OS process ran and printed structured output; it proves NOTHING
+// about whether the requested work was actually done. #834's worker exited 0 having done zero of the
+// three requested remediation cycles because Bash/test/build/lint execution was denied for the whole
+// session. #835's worker exited 0 having implemented and tested code, but explicitly reported that git
+// write access was denied, so the requested draft PR / governed artifact was never produced. Both were
+// persisted COMPLETE. Neither was complete.
+//
+// THE FIX: a deterministic gate between "the runtime finished" and "EOS records COMPLETE". It never
+// trusts process exit alone (necessary, not sufficient — requirement #3) and it never derives status
+// from keyword-matching the worker's prose alone (requirement #1): the decisive inputs are the
+// request's OWN structured completion criteria (required artifact types, required test/build/lint
+// evidence), the Verifier's verdict when one ran (#820's PASS/RETURN_FOR_CORRECTION/ESCALATE, whose
+// fail-closed precedence this gate preserves untouched), and what was actually produced (artifacts,
+// evidence records). Free-text detection of an explicit worker statement ("blocked", "denied", "cannot
+// complete", a reported protected-Owner boundary) is used ONLY as CORROBORATING evidence: it can never
+// promote a result to COMPLETE, and — the exact defect this closes — it can never be silently
+// discarded into a false COMPLETE either (requirement #2). Absent any completion criteria at all (a
+// legacy/under-specified request), an explicit blocker/denial statement is still sufficient on its own
+// to keep the result off COMPLETE; it degrades to the most specific determinable non-COMPLETE outcome
+// rather than being ignored.
+//
+// Pure. No I/O, no clock. Called by intakeExecute.mjs after a wake reports SPAWNED_COMPLETED and
+// before any COMPLETE status/result is built.
+
+// Distinguishes the five outcomes EOS-ISSUE-836 requires at minimum. COMPLETE is earned, not assumed.
+export const EOS_OUTCOME = Object.freeze([
+  "COMPLETE",                 // all required completion criteria satisfied; required artifacts/evidence exist
+  "BLOCKED_EXECUTION",        // required tool/capability unavailable or denied — requested work could not run
+  "AWAITING_ARTIFACTIZATION", // implementation/evidence exists but the required governed patch/PR/artifact was not created
+  "RETURN_FOR_CORRECTION",    // verifier/content mismatch or a correctable defect (feeds the existing #820 loop)
+  "OWNER_ACTION_REQUIRED",    // a genuine protected Owner boundary, or an ambiguous blocker that must not default to COMPLETE
+]);
+
+// Corroborating signal only (requirement #1: never the sole basis). Split by WHAT kind of denial is
+// being reported so the gate can distinguish "couldn't execute at all" (#834: Bash/test/build/lint
+// denied, zero cycles run) from "executed but couldn't artifactize" (#835: implementation done, git/PR
+// writes denied). An unrecognized-but-clearly-a-refusal statement still corroborates — it just can't be
+// categorized, so it is routed to the conservative OWNER_ACTION_REQUIRED fallback rather than COMPLETE.
+const EXECUTION_CAPABILITY_BLOCKER_PATTERNS = Object.freeze([
+  /\bbash (?:is|was) (?:completely )?denied\b/i,
+  /\btool execution (?:is|was) denied\b/i,
+  /\bcan(?:'|no)t run (?:the )?(?:test|build|lint)/i,
+  /\bcouldn'?t run (?:any )?(?:test|build|lint)/i,
+  /\bno test\/build\/lint\b/i,
+  /\bworker execution (?:is|was) denied\b/i,
+  /\bcannot execute\b/i,
+  /\bhard blocker\b/i,
+]);
+
+const ARTIFACT_WRITE_BLOCKER_PATTERNS = Object.freeze([
+  /\bgit (?:write )?operations?\b.*\b(?:denied|blocked)\b/i,
+  /\b(?:commit|push|checkout)\b.*\b(?:are|is|being) (?:all )?(?:being )?denied\b/i,
+  /\bcan(?:'|no)t (?:commit|push|open a (?:pr|pull request))/i,
+  /\bwon'?t (?:attempt|try) (?:a |to )?(?:work[- ]?around|bypass)/i,
+  /\bstop(?:ping)? attempting git operations\b/i,
+  /\bdraft pr\b.*\b(?:not|wasn'?t|was not) (?:created|opened)\b/i,
+]);
+
+const GENERIC_BLOCKER_PATTERNS = Object.freeze([
+  /\bdenied\b/i,
+  /\bcannot complete\b/i,
+  /\bcan'?t complete\b/i,
+  /\bblocked\b/i,
+  /\bhit a hard boundary\b/i,
+  /\bI'?m pausing here\b/i,
+  /\bstopping here\b/i,
+]);
+
+const OWNER_BOUNDARY_PATTERNS = Object.freeze([
+  /\bowner decision required\b/i,
+  /\brequires? (?:an )?owner\b/i,
+  /\bprotected (?:owner )?boundary\b/i,
+  /\bneed you to (?:either )?grant\b/i,
+  /\bgrant (?:bash|git|write) (?:access|permissions?)\b/i,
+]);
+
+function matchesAny(patterns, text) {
+  return patterns.filter((re) => re.test(text)).map((re) => re.source);
+}
+
+/**
+ * Scan the worker's OWN reported text for corroborating (never sole-basis) blocker signals. Returns
+ * which categories matched — the gate uses category, not raw presence, to pick the most specific
+ * non-COMPLETE outcome rather than a generic catch-all.
+ */
+export function detectExecutionBlockerSignal(resultText) {
+  const text = String(resultText || "");
+  const executionCapability = matchesAny(EXECUTION_CAPABILITY_BLOCKER_PATTERNS, text);
+  const artifactWrite = matchesAny(ARTIFACT_WRITE_BLOCKER_PATTERNS, text);
+  const generic = matchesAny(GENERIC_BLOCKER_PATTERNS, text);
+  const ownerBoundary = matchesAny(OWNER_BOUNDARY_PATTERNS, text);
+  return Object.freeze({
+    executionCapabilityBlocked: executionCapability.length > 0,
+    artifactWriteBlocked: artifactWrite.length > 0,
+    genericBlocker: generic.length > 0 || executionCapability.length > 0 || artifactWrite.length > 0,
+    ownerBoundary: ownerBoundary.length > 0,
+    matches: Object.freeze({ executionCapability, artifactWrite, generic, ownerBoundary }),
+  });
+}
+
+/**
+ * Structural check: does the produced-artifacts list actually carry every artifact TYPE the request's
+ * completion criteria require (e.g. "patch", "pr", "report")? A type match against real produced
+ * artifacts — never a keyword match against the worker's claim that it "created" something.
+ */
+export function assessArtifactCompletion({ requiredArtifactTypes = [], producedArtifacts = [] } = {}) {
+  const produced = new Set(
+    (producedArtifacts || []).map((a) => (typeof a === "string" ? a : a && a.type)).filter(Boolean),
+  );
+  const missing = (requiredArtifactTypes || []).filter((t) => !produced.has(t));
+  return Object.freeze({ satisfied: missing.length === 0, missing: Object.freeze(missing) });
+}
+
+/**
+ * Structural check: when the request's completion criteria require test/build/lint evidence, does at
+ * least one produced evidence record actually carry a PASS outcome for one of those runtime checks?
+ * Never inferred from the worker saying "tests pass" in prose.
+ */
+export function assessTestEvidence({ requiresTestEvidence = false, producedEvidence = [] } = {}) {
+  if (!requiresTestEvidence) return Object.freeze({ satisfied: true, reason: "not required by completion criteria" });
+  const hasPassingRun = (producedEvidence || []).some(
+    (e) => e && ["TEST_RUN", "BUILD_RUN", "LINT_RUN"].includes(e.type) && e.outcome === "PASS",
+  );
+  return Object.freeze({
+    satisfied: hasPassingRun,
+    reason: hasPassingRun ? "passing test/build/lint evidence present" : "required test/build/lint evidence is missing",
+  });
+}
+
+/**
+ * The gate. Called once per SPAWNED_COMPLETED wake, before a COMPLETE status/result is ever built.
+ *
+ * @param {object} p
+ * @param {string} p.requestId
+ * @param {string} p.resultText            the worker's own reported output text (corroborating only)
+ * @param {object} [p.completionCriteria]  structured, request-level criteria: { requiresArtifacts: string[], requiresTestEvidence: boolean }
+ * @param {"PASS"|"RETURN_FOR_CORRECTION"|"ESCALATE"|null} [p.verifierVerdict]  #820 Verifier verdict, when one ran
+ * @param {Array} [p.producedArtifacts]    artifacts actually produced this run ({ type, location } or a type string)
+ * @param {Array} [p.producedEvidence]     evidence records actually produced this run ({ type, outcome })
+ * @returns {{ status, reason, evidence }}  status is one of EOS_OUTCOME
+ */
+export function gateOutcome({
+  requestId,
+  resultText = "",
+  completionCriteria = {},
+  verifierVerdict = null,
+  producedArtifacts = [],
+  producedEvidence = [],
+} = {}) {
+  if (!requestId) throw new Error("gateOutcome: requestId is required");
+
+  const signal = detectExecutionBlockerSignal(resultText);
+  const requiredArtifactTypes = completionCriteria.requiresArtifacts || [];
+  const requiresTestEvidence = completionCriteria.requiresTestEvidence === true;
+  const artifactCheck = assessArtifactCompletion({ requiredArtifactTypes, producedArtifacts });
+  const testCheck = assessTestEvidence({ requiresTestEvidence, producedEvidence });
+  const evidence = Object.freeze({ signal, artifactCheck, testCheck, verifierVerdict });
+
+  const decide = (status, reason) => Object.freeze({ status, reason, evidence });
+
+  // #820 Verifier fail-closed precedence is preserved untouched: a Verifier verdict, when present,
+  // decides RETURN_FOR_CORRECTION / ESCALATE before this gate applies its own heuristics.
+  if (verifierVerdict === "RETURN_FOR_CORRECTION") {
+    return decide("RETURN_FOR_CORRECTION", "Verifier returned findings requiring correction (#820)");
+  }
+  if (verifierVerdict === "ESCALATE") {
+    return decide("OWNER_ACTION_REQUIRED", "Verifier escalated — no independently-verifiable PASS (#820)");
+  }
+
+  // Requirement #2: an explicit, corroborated denial of required EXECUTION capability (Bash/test/
+  // build/lint) is never normalized to COMPLETE — this is exactly the #834 shape (zero cycles ran).
+  if (signal.executionCapabilityBlocked) {
+    return decide("BLOCKED_EXECUTION", "worker explicitly reported a denied/unavailable required execution capability (tool/test/build/lint)");
+  }
+  // A required execution capability is provably missing even without matching text, whenever the
+  // request demands test/build/lint evidence and none was produced.
+  if (requiresTestEvidence && !testCheck.satisfied && producedArtifacts.length === 0 && producedEvidence.length === 0) {
+    return decide("BLOCKED_EXECUTION", testCheck.reason);
+  }
+
+  // Requirement #2, artifact case: implementation/evidence exists but the specific governed artifact
+  // (patch/PR/report) the request required was not produced — the #835 shape.
+  if (signal.artifactWriteBlocked || !artifactCheck.satisfied) {
+    const reason = signal.artifactWriteBlocked
+      ? "worker explicitly reported required governed-artifact writes (git/PR/patch) denied or not performed"
+      : `required artifact type(s) not produced: ${artifactCheck.missing.join(", ")}`;
+    return decide("AWAITING_ARTIFACTIZATION", reason);
+  }
+
+  // Any other explicit blocker/refusal language that didn't match a specific category, or an explicit
+  // protected-Owner-boundary statement: fail closed to OWNER_ACTION_REQUIRED rather than guess.
+  if (signal.ownerBoundary) {
+    return decide("OWNER_ACTION_REQUIRED", "worker explicitly reported a protected Owner boundary");
+  }
+  if (signal.genericBlocker) {
+    return decide("OWNER_ACTION_REQUIRED", "worker explicitly reported a blocker/refusal that could not be categorized — fail-closed, never silently COMPLETE");
+  }
+
+  if (!testCheck.satisfied) {
+    return decide("RETURN_FOR_CORRECTION", testCheck.reason);
+  }
+
+  return decide("COMPLETE", "all required completion criteria satisfied and required artifacts/evidence exist");
+}
