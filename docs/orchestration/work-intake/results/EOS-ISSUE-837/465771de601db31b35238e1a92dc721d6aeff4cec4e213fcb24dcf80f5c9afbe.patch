+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  EOS_OUTCOME, gateOutcome, detectExecutionBlockerSignal,
+  assessArtifactCompletion, assessTestEvidence,
+} from "./outcomeGate.mjs";
+
+// The exact worker text persisted for EOS-ISSUE-834 (docs/orchestration/work-intake/results/
+// EOS-ISSUE-834/b1d37cc3845281f6fd975cfc4a633d86d196e6851cf58d9a98dd5eed39db6be3.content.md) — Claude
+// stopped before cycle 1 because Bash/test/build/lint execution was denied. Zero remediation cycles ran.
+const EOS_834_TEXT = `Bash is completely denied in this session ("don't ask mode"). That's a hard blocker for this task: I can't run the cold-start bootstrap script, \`gh issue view\` to pull #833's findings, or — critically — the test/build/lint checks that step 4 of every cycle requires to verify fixes before moving on. I also can't run the 10-worker read-only sweeps as actual processes.
+
+Before I improvise a workaround (e.g., trying to read raw file contents to reconstruct #833's findings, or asking subagents to do the Bash work on my behalf), I want to flag this clearly rather than silently degrade the experiment:
+
+- This EOS_INTAKE task is large — 3 full cycles, each with implementation, regression tests, verification, a 10-worker sweep, and consolidation — and it explicitly requires running real checks (tests/build/lint) to gate each fix, and requires "actualProviderCostUsd" telemetry from real worker runs.
+- Without Bash I cannot: check out issue #833 via \`gh\`, run \`npm test\`/lint/build, or execute any verification step. I also can't confirm current git/branch state directly (though the system reminder already tells me: branch \`HEAD\`, tree clean).
+- I *can* still use Read/Grep/Glob to inspect the repo, and the Agent tool to delegate sub-tasks — but if those subagents also run under this same permission mode, they'll hit the same Bash denial for verification steps.
+
+Can you either:
+1. Grant Bash access for this session (even scoped to read-only/test commands), or
+2. Confirm you want me to proceed in a degraded mode — code review/reasoning only, no test/build verification, no \`gh\` lookups, findings reconstructed from local files only — which would not satisfy the "run relevant test/build/lint checks" requirement in the task spec?
+
+I don't want to fabricate test-passing claims or telemetry data for a governance-sensitive experiment like this, so I'm pausing here rather than guessing.`;
+
+// The exact worker text persisted for EOS-ISSUE-835 (docs/orchestration/work-intake/results/
+// EOS-ISSUE-835/40d4a5fc98488bf9bc4c247db748076eb91035d506f9f8e38e330348d7c0c1b7.content.md) — implementation
+// and tests were done, but git/PR writes were denied, so the requested draft PR/governed artifact never landed.
+const EOS_835_TEXT = `Implementation and tests are complete, but I've hit a hard boundary: git write operations (\`add\`, \`commit\`, \`checkout\`, \`push\`) are all being denied in this sandboxed session ("Claude Code is running in don't ask mode"), even benign ones. Per the tool's explicit instruction, I should not try to work around that — I'll stop attempting git operations and report status instead of guessing at a bypass.
+
+**What's done, sitting in the working tree at \`docs/orchestration/lib/\`:**
+
+1. **\`cortexProviderAdapter.mjs\`** — added the \`PATCH_PRODUCER\` mode alongside the unchanged \`READ_ONLY_PILOT\` mode.
+2. **\`cortexPatchProducer.test.mjs\`** (new, 21 tests) — covers all 10 required scenarios.
+
+All 36 tests in \`cortexProviderAdapter.test.mjs\` + \`cortexPatchProducer.test.mjs\` pass; the 6 pre-existing failures elsewhere in the suite are unrelated and untouched by this change.
+
+I need you to either grant git/PR permissions for this session or handle the commit/branch/draft-PR step yourself (or via the wrapping EOS workflow) — I won't attempt to route around the denial.`;
+
+test("EOS_OUTCOME enumerates the five required statuses", () => {
+  assert.deepEqual([...EOS_OUTCOME], [
+    "COMPLETE", "BLOCKED_EXECUTION", "AWAITING_ARTIFACTIZATION", "RETURN_FOR_CORRECTION", "OWNER_ACTION_REQUIRED",
+  ]);
+});
+
+// ---- #834 reproduction: zero cycles ran, required test/build/lint execution denied ----
+test("#834 shape: explicit Bash/test/build/lint denial → BLOCKED_EXECUTION, never COMPLETE", () => {
+  const signal = detectExecutionBlockerSignal(EOS_834_TEXT);
+  assert.equal(signal.executionCapabilityBlocked, true);
+
+  const out = gateOutcome({
+    requestId: "EOS-ISSUE-834",
+    resultText: EOS_834_TEXT,
+    completionCriteria: { requiresArtifacts: ["report"], requiresTestEvidence: true },
+    producedArtifacts: [], producedEvidence: [],
+  });
+  assert.equal(out.status, "BLOCKED_EXECUTION");
+  assert.notEqual(out.status, "COMPLETE");
+});
+
+test("#834 shape: still BLOCKED_EXECUTION with NO structured completionCriteria at all (legacy request)", () => {
+  const out = gateOutcome({ requestId: "EOS-ISSUE-834", resultText: EOS_834_TEXT });
+  assert.equal(out.status, "BLOCKED_EXECUTION");
+});
+
+// ---- #835 reproduction: implementation/tests done, required governed artifact (draft PR) never created ----
+test("#835 shape: explicit git/PR-write denial with implementation done → AWAITING_ARTIFACTIZATION, never COMPLETE", () => {
+  const signal = detectExecutionBlockerSignal(EOS_835_TEXT);
+  assert.equal(signal.artifactWriteBlocked, true);
+  assert.equal(signal.executionCapabilityBlocked, false, "835 is an artifact-write denial, not an execution-capability denial");
+
+  const out = gateOutcome({
+    requestId: "EOS-ISSUE-835",
+    resultText: EOS_835_TEXT,
+    completionCriteria: { requiresArtifacts: ["pr"], requiresTestEvidence: true },
+    producedArtifacts: [], producedEvidence: [{ type: "TEST_RUN", outcome: "PASS" }],
+  });
+  assert.equal(out.status, "AWAITING_ARTIFACTIZATION");
+  assert.notEqual(out.status, "COMPLETE");
+});
+
+test("#835 shape: still AWAITING_ARTIFACTIZATION with NO structured completionCriteria at all (legacy request)", () => {
+  const out = gateOutcome({ requestId: "EOS-ISSUE-835", resultText: EOS_835_TEXT });
+  assert.equal(out.status, "AWAITING_ARTIFACTIZATION");
+});
+
+// ---- positive regression: a genuinely satisfied request still reaches COMPLETE ----
+test("genuinely satisfied request (no blocker text, required artifact + test evidence both produced) → COMPLETE", () => {
+  const out = gateOutcome({
+    requestId: "EOS-EXEC-OK",
+    resultText: "# result\nImplemented the fix, added regression tests, all green. Draft PR opened.",
+    completionCriteria: { requiresArtifacts: ["patch"], requiresTestEvidence: true },
+    producedArtifacts: [{ type: "patch", location: "x.patch" }],
+    producedEvidence: [{ type: "TEST_RUN", outcome: "PASS" }],
+  });
+  assert.equal(out.status, "COMPLETE");
+});
+
+test("no completion criteria and no blocker text → COMPLETE (unchanged legacy behavior)", () => {
+  const out = gateOutcome({ requestId: "EOS-EXEC-OK", resultText: "did the thing, all good" });
+  assert.equal(out.status, "COMPLETE");
+});
+
+// ---- #820 Verifier fail-closed precedence is preserved ----
+test("Verifier RETURN_FOR_CORRECTION always wins over a clean-looking worker report", () => {
+  const out = gateOutcome({
+    requestId: "EOS-EXEC-VC", resultText: "all done, tests pass",
+    verifierVerdict: "RETURN_FOR_CORRECTION",
+  });
+  assert.equal(out.status, "RETURN_FOR_CORRECTION");
+});
+
+test("Verifier ESCALATE always wins over a clean-looking worker report", () => {
+  const out = gateOutcome({
+    requestId: "EOS-EXEC-VE", resultText: "all done, tests pass",
+    verifierVerdict: "ESCALATE",
+  });
+  assert.equal(out.status, "OWNER_ACTION_REQUIRED");
+});
+
+test("Verifier PASS does not itself force COMPLETE — gate still requires satisfied artifact/test criteria", () => {
+  const out = gateOutcome({
+    requestId: "EOS-EXEC-VP", resultText: "all done",
+    verifierVerdict: "PASS",
+    completionCriteria: { requiresArtifacts: ["pr"] },
+    producedArtifacts: [],
+  });
+  assert.equal(out.status, "AWAITING_ARTIFACTIZATION");
+});
+
+// ---- required test/build/lint evidence, required artifacts ----
+test("assessArtifactCompletion: missing artifact type is reported", () => {
+  const r = assessArtifactCompletion({ requiredArtifactTypes: ["pr", "report"], producedArtifacts: [{ type: "pr" }] });
+  assert.equal(r.satisfied, false);
+  assert.deepEqual([...r.missing], ["report"]);
+});
+
+test("assessTestEvidence: not required → satisfied trivially", () => {
+  assert.equal(assessTestEvidence({ requiresTestEvidence: false }).satisfied, true);
+});
+
+test("assessTestEvidence: required but no passing run present → not satisfied", () => {
+  const r = assessTestEvidence({ requiresTestEvidence: true, producedEvidence: [{ type: "TEST_RUN", outcome: "FAIL" }] });
+  assert.equal(r.satisfied, false);
+});
+
+test("required test evidence missing (no blocker text) → RETURN_FOR_CORRECTION, not COMPLETE and not BLOCKED_EXECUTION", () => {
+  const out = gateOutcome({
+    requestId: "EOS-EXEC-TC", resultText: "implemented the fix",
+    completionCriteria: { requiresTestEvidence: true },
+    producedArtifacts: [{ type: "patch" }], producedEvidence: [],
+  });
+  assert.equal(out.status, "RETURN_FOR_CORRECTION");
+});
+
+// ---- explicit protected-Owner-boundary statement never becomes COMPLETE ----
+test("explicit protected Owner boundary statement → OWNER_ACTION_REQUIRED, never COMPLETE", () => {
+  const out = gateOutcome({
+    requestId: "EOS-EXEC-OB",
+    resultText: "This requires an Owner decision: it crosses a protected Owner boundary (Firestore Rules deploy). I need you to grant deploy permissions.",
+  });
+  assert.equal(out.status, "OWNER_ACTION_REQUIRED");
+});
+
+// ---- an unclassifiable but explicit refusal never falls through to COMPLETE ----
+test("unclassifiable explicit refusal text → OWNER_ACTION_REQUIRED (fail-closed), never COMPLETE", () => {
+  const out = gateOutcome({ requestId: "EOS-EXEC-U", resultText: "I cannot complete this task as scoped." });
+  assert.notEqual(out.status, "COMPLETE");
+  assert.equal(out.status, "OWNER_ACTION_REQUIRED");
+});
+
+test("gateOutcome requires requestId", () => {
+  assert.throws(() => gateOutcome({ resultText: "x" }), /requestId is required/);
+});
