+  const built = createCortexPatchProducerProviderRun({ broker, authorizedInvocation: grant(), estimateSpendUsd: () => 0.1, invokeOpenAI: async () => ({}), spendLedger: createInMemorySpendLedger(), configuredModel: "" });
