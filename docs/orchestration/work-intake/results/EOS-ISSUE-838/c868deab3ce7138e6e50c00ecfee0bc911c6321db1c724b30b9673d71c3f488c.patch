+// ── EOS-ISSUE-838: task-class turn policy ──
+// #836/#837 both hit exactly the old fixed 40-turn ceiling mid-correction and terminated FAILED
+// before finishing otherwise-bounded work. These regressions prove: (1) a CORRECTION/IMPLEMENTATION
+// item is actually invoked with the raised, still-finite 80-turn ceiling (so a task that legitimately
+// needs, say, 55 turns is not cut off by the old 40-turn limit), (2) exceeding whatever ceiling WAS
+// configured still fails closed (never COMPLETE), and (3) the configured ceiling is always recorded
+// in the returned telemetry so a future max-turns failure is diagnosable without re-running.
+
+test("a CORRECTION item is invoked with --max-turns 80 (not the old 40) — the fixed ceiling that caused #836/#837 no longer applies", () => {
+  const runner = mockRunner({ exitCode: 0, stdout: cleanOutput });
+  const r = executeWake(base({ item: okItem({ taskClass: "CORRECTION" }), processRunner: runner, lease: mockLease() }));
+  assert.equal(r.outcome, "SPAWNED_COMPLETED");
+  assert.equal(r.configuredMaxTurns, 80);
+  const invokedArgv = runner.calls[0].argv.join(" ");
+  assert.match(invokedArgv, /--max-turns 80/);
+});
+
+test("ordinary analysis (no taskClass) is still invoked with --max-turns 40", () => {
+  const runner = mockRunner({ exitCode: 0, stdout: cleanOutput });
+  const r = executeWake(base({ processRunner: runner, lease: mockLease() }));
+  assert.equal(r.configuredMaxTurns, 40);
+  assert.match(runner.calls[0].argv.join(" "), /--max-turns 40/);
+});
+
+test("hitting the configured max-turns ceiling is classified MAX_TURNS_EXCEEDED and stays FAILED, never COMPLETE", () => {
+  const maxTurnsStdout = JSON.stringify({ subtype: "error_max_turns", errors: ["Reached maximum number of turns (80)"] });
+  const r = executeWake(base({
+    item: okItem({ taskClass: "IMPLEMENTATION" }),
+    processRunner: mockRunner({ exitCode: 1, stdout: maxTurnsStdout }),
+    lease: mockLease(),
+  }));
+  assert.equal(r.outcome, "SPAWNED_FAILED");
+  assert.notEqual(r.wakeState, "COMPLETED");
+  assert.equal(r.failureKind, "MAX_TURNS_EXCEEDED");
+  assert.equal(r.configuredMaxTurns, 80, "the ceiling that was actually configured is recorded for diagnosis");
+  assert.match(r.failureDetail, /max-turns ceiling \(80\) reached/);
+});
+
+test("exceeding whatever ceiling was configured still fails closed — a bounded 80-turn run that also hits max-turns is FAILED, not COMPLETE", () => {
+  const maxTurnsStdout = JSON.stringify({ subtype: "error_max_turns", errors: ["Reached maximum number of turns (80)"] });
+  const r = executeWake(base({
+    item: okItem({ taskClass: "CORRECTION" }),
+    processRunner: mockRunner({ exitCode: 1, stdout: maxTurnsStdout }),
+    lease: mockLease(),
+  }));
+  assert.equal(r.outcome, "SPAWNED_FAILED");
+  assert.notEqual(r.wakeState, "COMPLETED");
+  assert.notEqual(r.wakeState, "ACKNOWLEDGED");
+  assert.equal(r.failureKind, "MAX_TURNS_EXCEEDED");
+});
+
+test("a plain non-zero exit unrelated to max-turns is still classified NONZERO_EXIT, and both keep configuredMaxTurns on the record", () => {
