diff --git a/tmp_verify_backlog.mjs b/tmp_verify_backlog.mjs
new file mode 100644
index 0000000..318412f
--- /dev/null
+++ b/tmp_verify_backlog.mjs
@@ -0,0 +1,10 @@
+import { readFileSync } from "node:fs";
+import { computeAgentManagerRecommendation } from "./docs/orchestration/lib/integrationShadow.mjs";
+import { validateIntegrationBacklogItem } from "./docs/orchestration/lib/agentManager.mjs";
+
+const backlog = JSON.parse(readFileSync("./docs/orchestration/integration-backlog.json", "utf8"));
+for (const item of backlog.items) {
+  const errors = validateIntegrationBacklogItem(item);
+  console.log(item.requestId, "errors:", errors);
+}
+console.log(JSON.stringify(computeAgentManagerRecommendation(backlog), null, 2));
diff --git a/tmp_verify_backlog.test.mjs b/tmp_verify_backlog.test.mjs
new file mode 100644
index 0000000..30f519b
--- /dev/null
+++ b/tmp_verify_backlog.test.mjs
@@ -0,0 +1,14 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { computeAgentManagerRecommendation } from "./docs/orchestration/lib/integrationShadow.mjs";
+import { validateIntegrationBacklogItem } from "./docs/orchestration/lib/agentManager.mjs";
+
+test("A1/A2 backlog items validate and gate correctly", () => {
+  const backlog = JSON.parse(readFileSync("./docs/orchestration/integration-backlog.json", "utf8"));
+  for (const item of backlog.items) {
+    assert.deepEqual(validateIntegrationBacklogItem(item), [], `${item.requestId} should validate`);
+  }
+  const plan = computeAgentManagerRecommendation(backlog);
+  console.log(JSON.stringify(plan, null, 2));
+});
