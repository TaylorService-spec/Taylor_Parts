{
  "schemaVersion": 1,
  "program": "Taylor Customer 1 Parallel Execution Orchestrator",
  "config": {
    "maxConcurrentClaude": 1,
    "claudeExe": "C:\\Users\\Rudy2\\.local\\bin\\claude.exe",
    "claudePermissionMode": "acceptEdits",
    "claudeTimeoutSec": 3600,
    "worktreeRoot": "D:\\Taylor_C1_Lanes",
    "mainRef": "origin/main",
    "resultFileName": ".orchestrator-result.json",
    "autoMerge": false,
    "autoPushLaneBranch": false,
    "openPullRequest": false,
    "forbiddenPaths": [
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      ".firebaserc",
      "firebase.json",
      "docs/DECISIONS.md",
      "docs/DelegationCharter.md",
      "docs/architecture/SYSTEM_AUTHORITIES.md",
      ".github/workflows/**"
    ],
    "harnessOwnedPaths": [
      "docs/customer-1/automation/**",
      "scripts/customer1-automation/**",
      ".claude/skills/customer1-program/**"
    ],
    "claudeDisallowedTools": [
      "WebFetch",
      "WebSearch"
    ],
    "claudeAllowedTools": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(node --test:*)",
      "Bash(npm test)",
      "Bash(npm run:*)"
    ],
    "strictMcpConfig": true,
    "proofPolicy": {
      "note": "Positive allowlist. A worker may SUGGEST a proof; the harness decides whether it runs. This policy is read from the HARNESS worktree, never from the lane worktree, so a lane cannot authorize its own command. Every path here is also in harnessOwnedPaths, so a lane that edits it fails verification.",
      "maxCommandLength": 300,
      "rejectMetacharacters": ["&&", "||", ";", "|", "&", "`", "$(", "${", ">", "<", "\n", "\r"],
      "allow": [
        "^npm (test|run [A-Za-z0-9:_-]+)$",
        "^npm (test|run [A-Za-z0-9:_-]+) -- [A-Za-z0-9 ._/@:=-]+$",
        "^node --test( [A-Za-z0-9._/*@-]+)+$",
        "^node [A-Za-z0-9._/-]+\\.(mjs|cjs|js)( [A-Za-z0-9._/=@:-]+)*$",
        "^npx (vitest|jest)( run)?( [A-Za-z0-9._/@:=-]+)*$",
        "^git (status|log|show|rev-parse|merge-base|ls-files|cat-file)( [A-Za-z0-9._/^~@:=-]+)*$",
        "^git diff( --(check|name-only|stat|cached))*( [A-Za-z0-9._/^~@:=-]+)*$",
        "^git branch --show-current$"
      ],
      "deny": [
        "firebase", "gcloud", "gsutil", "aws ", "az ",
        "git push", "git reset", "git clean", "git checkout", "git restore",
        "git branch -d", "git worktree", "git rebase", "git filter-branch", "git update-ref",
        "gh pr merge", "gh api", "gh secret", "gh release",
        "remove-item", "rmdir", "rm ", "del ", "erase ", "format ", "shutdown", "reboot",
        "invoke-expression", "iex ", "invoke-webrequest", "invoke-restmethod",
        "curl", "wget", "-method post", "-method put", "-method delete", "-method patch",
        "sudo", "chmod", "chown", "mklink", "reg add", "reg delete", "schtasks", "taskkill",
        "npm publish", "npm install", "npm i ", "npx -y", "pip install",
        "firestore:delete", "functions:delete", "auth:import", "auth:export",
        "node -e", "node --eval", "-c ", "start-process", "new-item", "set-content",
        "out-file", "add-content", "tee", "cmd /c", "powershell -", "pwsh -", "bash -c", "sh -c"
      ]
    }
  },
