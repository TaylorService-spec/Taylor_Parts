{
  "env": {
    "IMPECCABLE_NO_TELEMETRY": "1",
    "IMPECCABLE_NO_UPDATE_CHECK": "1"
  },
  "permissions": {
    "allow": [
      "Bash(ls -la \"/c/Users/Rudy2/Favorites/Downloads/\" 2>&1)",
      "Read(//c/Users/Rudy2/Favorites/Downloads//**)",
      "Bash(git pull *)",
      "Bash(npm --version)",
      "Skill(run)",
      "Skill(run:*)",
      "Bash(npm run lint)",
      "Bash(git fetch *)",
      "Bash(git ls-tree *)",
      "Bash(npm run typecheck)",
      "Bash(gh project item-list *)",
      "Bash(git check-ignore *)",
      "Bash(git merge-base *)",
      "Bash(gh project field-list *)",
      "Bash(gh project list *)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(git remote -v)",

      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(node --test *)",
      "Bash(node --version)",

      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Bash(firebase deploy*)",
      "Bash(npx firebase deploy*)",
      "Bash(firebase functions:delete*)",
      "Bash(firebase firestore:delete*)",
      "Bash(gh secret*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/session-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/rules-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/unpublished-work-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
